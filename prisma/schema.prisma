// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  DELISTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum NotificationType {
  NEW_PRODUCT
  ORDER_UPDATE
  SYSTEM
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  passwordHash           String
  role                   Role                @default(BUYER)
  status                 UserStatus          @default(ACTIVE)
  displayName            String?
  bio                    String?
  avatarUrl              String?
  phoneNumber            String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  county                 String?
  postcode               String?
  country                String?      @default("United Kingdom")
  mfaEnabled             Boolean             @default(false)
  mfaSecret              String?
  stripeConnectAccountId String?             @unique
  payoutMethod           String?
  payoutPayeeName        String?
  payoutEmail            String?
  payoutBankName         String?
  payoutBankAccountLast4 String?
  payoutBankSortCodeLast2 String?
  payoutPaypalEmail      String?
  payoutNotes            String?
  payoutAdminNotes       String?
  payoutUpdatedAt        DateTime?
  termsAcceptedAt        DateTime?
  marketingOptIn         Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  sellerApplication      SellerApplication?
  savedAddresses         SavedAddress[]
  reviewedApplications   SellerApplication[] @relation("ApplicationReviewer")
  products               Product[]
  cart                   Cart?
  buyerOrders            Order[]             @relation("BuyerOrders")
  sellerOrders           Order[]             @relation("SellerOrders")
  reviewsAsAdmin         AuditLog[]          @relation("AdminAuditActor")
  sentMessages           Message[]           @relation("SentMessages")
  disputeMessages        DisputeMessage[]    @relation("DisputeMessages")
  conversations          ConversationParticipant[]
  raisedDisputes         Dispute[]           @relation("RaisedDisputes")
  resolvedDisputes       Dispute[]           @relation("ResolvedDisputes")
  productReviews         Review[]
  shopFollowers          SellerFollow[]      @relation("SellerFollowers")
  followingShops         SellerFollow[]      @relation("BuyerFollowing")
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]
  pendingCheckouts       PendingCheckout[]
  sellerPayouts          SellerPayout[]      @relation("SellerPayouts")
  shopProfile            ShopProfile?        @relation("ShopProfile")
  deliveryProfile        DeliveryProfile?    @relation("DeliveryProfile")
  returnRequestsAsBuyer  ReturnRequest[]     @relation("ReturnBuyer")
  returnRequestsAsSeller ReturnRequest[]     @relation("ReturnSeller")
  reviewedReturnRequests ReturnRequest[]     @relation("ReturnReviewer")

  @@index([role])
  @@index([status])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  body         String
  href         String?
  productId    String?
  actorUserId  String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}

model SavedAddress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  addressLine1   String
  addressLine2   String?
  city           String
  postalCode     String
  country        String   @default("GB")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model SellerFollow {
  id        String   @id @default(uuid())
  sellerId  String
  buyerId   String
  createdAt DateTime @default(now())
  seller    User     @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User     @relation("BuyerFollowing", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
}

model SellerApplication {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  shopName              String                  @unique
  description           String
  businessType          String?
  businessAddress       String?
  vatNumber             String?
  planToSell            String?
  sellerTermsAcceptedAt DateTime?
  confirmedAdult        Boolean                 @default(false)
  status                SellerApplicationStatus @default(PENDING)
  submittedAt           DateTime                @default(now())
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNotes           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy            User?                   @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reviewedById])
}

model Product {
  id                 String        @id @default(uuid())
  sellerId           String
  title              String
  description        String
  priceCents         Int
  imageUrls          String[]
  stock              Int           @default(0)
  status             ProductStatus @default(ACTIVE)
  listedAt           DateTime      @default(now())
  renewalNotifiedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([sellerId])
  @@index([status])
}

model Cart {
  id        String     @id @default(uuid())
  buyerId   String     @unique
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([expiresAt])
}

model CartItem {
  id           String   @id @default(uuid())
  cartId       String
  productId    String
  quantity     Int
  unitPriceCts Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                  String      @id @default(uuid())
  buyerId             String
  sellerId            String
  status              OrderStatus @default(PENDING_PAYMENT)
  totalCents          Int
  addressFullName     String?
  addressLine1        String?
  addressLine2        String?
  addressCity         String?
  addressPostalCode   String?
  addressCountry      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  buyer               User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller              User        @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payment             Payment?
  dispute             Dispute?
  returnRequest       ReturnRequest?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceCents  Int
  productSnapshot String
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  stripePaymentIntent  String?
  amountCents          Int
  status               PaymentStatus @default(PENDING)
  refundAmountCents    Int           @default(0)
  refundedAt           DateTime?
  stripeRefundId       String?
  refundReason         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model StripeWebhookEvent {
  id           String             @id @default(uuid())
  eventId      String             @unique
  provider     String             @default("stripe")
  eventType    String
  status       WebhookEventStatus @default(PROCESSING)
  attemptCount Int                @default(1)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  buyerId    String
  rating     Int
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
  @@index([productId])
  @@index([buyerId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorAdmin  String
  action      String
  targetType  String
  targetId    String
  details     String?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminAuditActor", fields: [actorAdmin], references: [id], onDelete: Restrict)

  @@index([actorAdmin])
  @@index([targetType, targetId])
}

// ── Messaging ──────────────────────────────────────────────────────────────

model Conversation {
  id          String    @id @default(uuid())
  subject     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  participants ConversationParticipant[]
  messages    Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

// ── Disputes ───────────────────────────────────────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CLOSED
}

model Dispute {
  id           String           @id @default(uuid())
  orderId      String           @unique
  raisedById   String
  reason       String
  details      String
  status       DisputeStatus    @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  raisedBy     User             @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy   User?            @relation("ResolvedDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)
  messages     DisputeMessage[]

  @@index([status])
  @@index([raisedById])
}

model ReturnRequest {
  id             String              @id @default(uuid())
  orderId        String              @unique
  buyerId        String
  sellerId       String
  reason         String
  details        String
  status         ReturnRequestStatus @default(REQUESTED)
  requestedAt    DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  requestedByIp  String?
  resolutionNote String?
  reviewedById   String?
  reviewedAt     DateTime?
  rmaCode        String              @unique
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer          User                @relation("ReturnBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User                @relation("ReturnSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  reviewedBy     User?               @relation("ReturnReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, requestedAt])
  @@index([requestedAt])
}

model DisputeMessage {
  id         String   @id @default(uuid())
  disputeId  String
  senderId   String
  body       String
  createdAt  DateTime @default(now())
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender     User     @relation("DisputeMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@index([senderId])
}

// ── Password Reset ─────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Pending Checkout (pre-payment order staging) ───────────────────────────

model PendingCheckout {
  id                  String    @id @default(uuid())
  buyerId             String
  deliveryOptionId    String
  deliveryOptionName  String
  addressFullName     String?
  addressLine1        String?
  addressLine2        String?
  addressCity         String?
  addressPostalCode   String?
  addressCountry      String?
  cartSnapshot        Json
  totalCents          Int
  stripePaymentIntent String?   @unique
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  buyer               User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([stripePaymentIntent])
  @@index([expiresAt])
}

// ── Payout Ledger (audit trail for all seller payouts) ───────────────────

enum PayoutStatus {
  PENDING
  PLATFORM_PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model ShopProfile {
  id          String   @id @default(uuid())
  sellerId    String   @unique
  seller      User     @relation("ShopProfile", fields: [sellerId], references: [id], onDelete: Cascade)
  logoUrl     String?
  bannerUrl   String?
  description String?
  websiteUrl  String?
  socialLinks Json?    // {twitter, instagram, facebook, etc}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
}

model DeliveryProfile {
  id          String   @id @default(uuid())
  sellerId    String   @unique
  seller      User     @relation("DeliveryProfile", fields: [sellerId], references: [id], onDelete: Cascade)
  options     Json     // [{id, name, costCents, daysMin, daysMax}]
  serviceType String   // "standard", "express", "pickup"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
}

model ImmutableAuditLog {
  id           String   @id @default(uuid())
  actor        String   // userId who performed action
  action       String   // "USER_DELETED", "ORDER_CANCELLED", "PAYOUT_MANUAL", etc
  targetType   String   // "user", "order", "payout", "product"
  targetId     String
  details      Json     // Full context of the change
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([targetType, targetId])
  @@index([timestamp])
}

model CookieConsentLog {
  id        String   @id @default(uuid())
  userId    String?
  choice    String
  version   String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model DsarRequest {
  id          String   @id @default(uuid())
  email       String
  requestType String
  details     String?
  userId      String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model SellerPayout {
  id                        String        @id @default(uuid())
  orderId                   String?
  sellerId                  String
  amountCents               Int
  platformFeeCents          Int
  netAmountCents            Int
  status                    PayoutStatus  @default(PLATFORM_PENDING)
  payoutMethod              String? // "stripe_connect", "bank_transfer", "paypal"
  stripeTransferId          String?       @unique
  stripePayout              Json?         // Complete Stripe transfer object
  failureReason             String?
  failureCode               String?
  manualPayoutNotes         String?
  scheduledAt               DateTime?
  settledAt                 DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  
  seller                    User          @relation("SellerPayouts", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([settledAt])
  @@unique([orderId])
}
